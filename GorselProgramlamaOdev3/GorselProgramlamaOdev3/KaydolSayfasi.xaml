<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="GorselProgramlamaOdev3.KaydolSayfasi"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Kaydol">


    <VerticalStackLayout Spacing="10" Margin="10" >
        <Label Text="Kullanıcı Bilgilerini Gir"
              VerticalOptions="Center" 
              HorizontalOptions="Center" 
              FontSize="15"/>
        <Label
            Text="Kaydol"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Entry 
            x:Name="KullaniciAdiEntry"
            Placeholder="Kullanıcı Adı" />

        <Entry
            x:Name="EmailEntry"
            Placeholder="E-posta"
            Keyboard="Email" />

        <Entry
            x:Name="SifreEntry"
            Placeholder="Şifre"
            IsPassword="True" />
        <HorizontalStackLayout Spacing="10"
                        HorizontalOptions="Center">
            <Button
            Text="Kaydol"
            Clicked="Kaydol_ButtonClicked" />
            <Button
            Text="İptal" WidthRequest="100"
            Clicked="Iptal_ButtonClicked" />
        </HorizontalStackLayout>

        <Button
            Text="Zaten hesabım var"
            Clicked="GirisSayfasinaDon_ButtonClicked"
            BackgroundColor="Transparent"
            TextColor="Blue" />

    </VerticalStackLayout>
</ContentPage>

