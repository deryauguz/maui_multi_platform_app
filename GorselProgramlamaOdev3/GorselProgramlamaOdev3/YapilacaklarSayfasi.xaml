<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GorselProgramlamaOdev3.YapilacaklarSayfasi"
             Title="Yapılacaklar Listesi"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20" >
        <VerticalStackLayout Spacing="8">
            <Entry x:Name="BaslikGiris" Placeholder="Görev Başlığı" FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            <Editor x:Name="DetayGiris" Placeholder="Görev Detayı..." HeightRequest="60" 
                    TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

            <Grid ColumnDefinitions="*, *">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Tarih Seçin:" FontSize="12" TextColor="Gray" />
                    <DatePicker x:Name="TarihSecici" Format="dd.MM.yyyy" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Saat Seçin:" FontSize="12" TextColor="Gray" />
                    <TimePicker x:Name="SaatSecici" Format="HH:mm" />
                </VerticalStackLayout>
            </Grid>

            <Button x:Name="IslemButonu" Text="GÖREVİ PLANLA" Clicked="OnEkleClicked" 
                    BackgroundColor="DarkGreen" TextColor="White" Margin="0,10,0,0" />

            <Button x:Name="IptalButonu" Text="DÜZENLEMEYİ İPTAL ET" Clicked="OnIptalClicked" 
                    BackgroundColor="Gray" TextColor="White" IsVisible="False" />
        </VerticalStackLayout>

        <ActivityIndicator x:Name="Yukleyici" Grid.Row="1" IsRunning="False" Color="DarkGreen" Margin="10" />

        <CollectionView Grid.Row="2" x:Name="TodoListe">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,8" Padding="15" HasShadow="True" CornerRadius="10" 
                           BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark=#1C1C1E}">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Spacing="5" Grid.Column="0">
                                <Label Text="{Binding Baslik}" FontSize="18" FontAttributes="Bold" TextColor="Orange" />
                                <Label Text="{Binding Detay}" FontSize="14" TextColor="Gray" />
                                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                    <Label Text="{Binding HedefTarih}" FontSize="12" FontAttributes="Bold" TextColor="DarkRed" />
                                    <Label Text="{Binding HedefSaat}" FontSize="12" FontAttributes="Bold" TextColor="DarkRed" />
                                    <CheckBox IsChecked="{Binding TamamlandiMi}" CheckedChanged="OnTamamlandiDegisti" Scale="0.8" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Start">
                                <Button Text="✏️" BackgroundColor="Transparent" FontSize="20" Clicked="OnDuzenleClicked" CommandParameter="{Binding .}" />
                                <Button Text="🗑" BackgroundColor="Transparent" FontSize="20" Clicked="OnSilClicked" CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>