<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GorselProgramlamaOdev3"
    x:Class="GorselProgramlamaOdev3.AppShell">
    
    <!-- Uygulama başlığında gösterilir -->
    <FlyoutItem Title="Ana Sayfa" Icon="home_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Kurlar" Icon="dkur_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:KurlarSayfasi}" />
    </FlyoutItem>

    <FlyoutItem Title="Haberler" Icon="haber_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:HaberlerSayfasi}" />
    </FlyoutItem>

    <FlyoutItem Title="Hava Durumu" Icon="hava_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:HavaDurumuSayfasi}" />
    </FlyoutItem>

    <FlyoutItem Title="Yapılacaklar" Icon="yapilacaklar_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:YapilacaklarSayfasi}" />
    </FlyoutItem>

    <FlyoutItem Title="Ayarlar" Icon="ayrlar_icon.png">
        <ShellContent ContentTemplate="{DataTemplate local:AyarlarSayfasi}" />
    </FlyoutItem>

</Shell>
